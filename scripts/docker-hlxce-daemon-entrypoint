#!/bin/bash

: "${DB_PASSWORD:?Set DB_PASSWORD: the image has no default password}"

# The daemon reads DB_HOST, DB_USERNAME, DB_PASSWORD and DB_NAME from the
# environment itself (readDbEnv() in HLstats.plib): nothing is written to the
# image, so it runs with a read-only root filesystem.

# exec, so the daemon gets SIGTERM from "docker stop" and flushes its queued events
exec perl hlstats.pl
