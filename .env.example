# Copy to .env (same folder: the repository root, one level above web/) and fill in.
# .env is ignored by git, so deployments never overwrite it.
# Keep it outside the web root: never put it inside web/.

DB_HOST=localhost
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

GOOGLE_MAPS_API_KEY=

# Optional. Public address of the site (the folder holding hlstats.php), e.g.
# https://stats.example.com/. Absolute links use it instead of the Host header,
# and https:// marks the admin session cookie Secure behind a TLS-terminating proxy.
SITE_URL=

# Optional. Comma-separated addresses or CIDR ranges of reverse proxies whose
# X-Forwarded-Proto header is trusted (e.g. 127.0.0.1,10.0.0.0/8).
TRUSTED_PROXIES=

# Optional. Web folder the heatmap generator (heatmaps/generate.php) writes its
# images to; defaults to the web folder of this checkout. The generator reads the
# DB_* settings above too.
HEATMAP_WEB_PATH=
