# The PHP files here are only meant to be included. The scripts and styles next to
# them (includes/js) are still served. nginx and Caddy ignore this file: deny the
# same files in their configuration (see README).
<FilesMatch "\.php$">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order deny,allow
		Deny from all
	</IfModule>
</FilesMatch>
