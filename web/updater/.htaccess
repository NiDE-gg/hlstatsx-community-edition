# The numbered scripts here are only meant to be included by the updater page
# (hlstats.php?mode=updater); index.php just redirects to it. nginx and Caddy ignore
# this file: deny the same files in their configuration (see README).
<FilesMatch "^(?!index\.php$).*\.php$">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order deny,allow
		Deny from all
	</IfModule>
</FilesMatch>
